# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Gmail credentials (use an App Password, not your main password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Defaults to GMAIL_USER when omitted
# EMAIL_TO=recipient@example.com

# X/Twitter API Bearer Token (from developer.x.com)
TWITTER_BEARER_TOKEN=AAAAAAAAA...

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# API runtime
API_KEY=replace-with-a-long-random-value
# Set only for an explicitly unsecured local development environment:
# ALLOW_UNAUTHENTICATED_ANALYSIS=true
# CONFIG_PATH=/app/config.yaml
# DATABASE_PATH=/data/signals.db
# CORS_ORIGINS=https://your-frontend.example
# LOG_LEVEL=INFO
